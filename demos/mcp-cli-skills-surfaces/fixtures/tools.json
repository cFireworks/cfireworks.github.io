{
  "server": "demo-ax-stand-in",
  "note": "Local stand-in. Not Arize's tool list and not a live MCP server.",
  "tools": [
    {
      "name": "list_projects",
      "title": "List projects",
      "description": "List projects visible to this key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "list_traces",
      "title": "List traces",
      "description": "List traces for one project, slowest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": ["project"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "get_experiment",
      "title": "Get experiment",
      "description": "Read one experiment run by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "experiment_id": {
            "type": "string"
          }
        },
        "required": ["experiment_id"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "create_evaluator",
      "title": "Create evaluator",
      "description": "Create an evaluator prompt. This writes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": ["name", "prompt"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    }
  ]
}
